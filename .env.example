# Copy to .env and fill with local-only values. Never commit .env.
MYSQL_DATABASE=ev_charging_db
MYSQL_USER=ev_charging_app
MYSQL_PASSWORD=replace-with-a-long-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-local-password

DB_URL=jdbc:mysql://mysql:3306/ev_charging_db
DB_USERNAME=ev_charging_app
DB_PASSWORD=replace-with-a-long-local-password
JWT_SECRET=replace-with-at-least-32-random-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Browser-visible API URL; this is compiled into the frontend bundle.
VITE_API_BASE_URL=http://localhost:8082/api
VITE_HMR_CLIENT_PORT=5173
